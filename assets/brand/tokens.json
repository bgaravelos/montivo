{
  "name": "Montivo",
  "version": "1.0 (27/10/2026)",
  "color": {
    "ink": {"hex": "#141414", "use": "backgrounds, type on paper, the brackets on light"},
    "paper": {"hex": "#F3F0E8", "use": "type on ink, light backgrounds, the brackets on dark"},
    "marker": {"hex": "#FFC629", "use": "the V, the one accent: primary action, playhead, version tag, highlighted words. Never body text on paper"},
    "graphite": {"hex": "#1E1E20", "use": "surfaces on ink: cards, panels"},
    "slate": {"hex": "#8E8B84", "use": "secondary text and rules on ink and paper"},
    "cut": {"hex": "#FF5A4E", "use": "errors and blocker issues only"},
    "pass": {"hex": "#5FD08E", "use": "a review that passes"}
  },
  "ui": {
    "bg": "#0E0E0F",
    "panel": "#151516",
    "panel-2": "#1B1B1D",
    "panel-3": "#232325",
    "line": "#262628",
    "line-2": "#343437",
    "text": "#F3F0E8",
    "text-2": "#B9B6AE",
    "mute": "#86847E",
    "dim": "#5A5955",
    "accent": "#FFC629",
    "accent-ink": "#141414"
  },
  "type": {
    "display": {"family": "Inter Tight", "weights": [700, 800], "tracking": "-0.02em", "use": "wordmark (outlined), headlines, title cards, captions in renders (800)"},
    "ui": {"family": "Inter", "weights": [400, 500, 600, 700], "use": "the editor UI and long text"},
    "mono": {"family": "JetBrains Mono", "weights": [500, 700], "use": "timecode, versions (v2), costs, scores, logs"}
  },
  "render": {
    "caption_text": "#FFFFFF",
    "caption_stroke": "#000000",
    "caption_highlight": "#FFC629",
    "callout_bg": "#FFC629",
    "callout_text": "#141414"
  },
  "logo": {
    "clear_space": "the bracket width (8/52 of the symbol's height) times 2 on every side",
    "min_size": {"symbol_px": 16, "lockup_px_high": 20},
    "files": "svg/ (built by build.py), png/ (build.py --png)"
  }
}
